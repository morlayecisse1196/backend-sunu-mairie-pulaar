# Copier ce fichier en `.env` (jamais committé, voir .gitignore) et renseigner
# les vraies valeurs. Le mobile et le front web ont chacun leur propre fichier
# d'exemple ; celui-ci décrit le SERVEUR.

# --- LLM (OpenRouter) ----------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase ------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ Ici, et SEULEMENT ici, la clé "service_role" : le serveur doit pouvoir
# écrire au nom de n'importe quel citoyen et contourner les policies RLS.
# Elle ne doit JAMAIS partir vers un client (mobile ou navigateur) — ceux-là
# utilisent la clé "anon public". Vérification rapide : décoder le JWT, le
# champ `role` doit valoir `service_role` ici et `anon` dans les clients.
SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Base de données (recherche sémantique pgvector, migrations) ----------
#
# ⚠️ NE PAS utiliser l'hôte direct `db.<ref>.supabase.co` : Supabase n'y
# publie plus qu'un enregistrement AAAA (IPv6). Une machine ou un VPS sans
# route IPv6 échoue avec « failed to resolve host », et la recherche
# sémantique retombe alors SILENCIEUSEMENT sur la recherche par mots-clés —
# l'agent répond encore, mais moins bien, sans que rien ne le signale.
#
# Utiliser le pooler, qui est en IPv4. L'adresse exacte se lit dans le
# dashboard : Project Settings > Database > Connection pooling.
#   - port 6543 = mode transaction : le bon choix ici, le code ouvre une
#     connexion par requête (cf. search2.get_db_connection)
#   - port 5432 = mode session
# Noter le nom d'utilisateur `postgres.<ref>`, différent de l'hôte direct.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:MOT_DE_PASSE@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Mot de passe de la base, pour les scripts qui construisent l'URL eux-mêmes.
SUPABASE_DB_PASSWORD=

# --- Services vocaux (Spaces Hugging Face) -------------------------------
# Ils s'endorment après inactivité : le premier appel a été mesuré à 55 s.
# `services/prechauffage.py` les réveille au démarrage du serveur pour que
# cette attente ne tombe pas sur le premier citoyen.
ASR_API_URL=https://xxxxxxxx-whisper-pulaar-api.hf.space
TTS_API_URL=https://xxxxxxxx-tts-pulaar-docker.hf.space
# Optionnel — doit correspondre au secret TTS_API_KEY du Space.
TTS_API_KEY=

# --- CORS ----------------------------------------------------------------
# Origines web autorisées, séparées par des virgules. Il y a plusieurs fronts
# (espace consultant/admin, espace citoyen) : une seule valeur ferait refuser
# les autres en 400 au preflight.
# Vide en développement = ports 3000 et 3001, en localhost et 127.0.0.1.
# En production, lister les vraies origines et RIEN de plus (jamais `*` : le
# middleware envoie allow_credentials, que les navigateurs refusent avec `*`).
#   FRONTEND_URLS=https://agents.exemple.sn,https://citoyen.exemple.sn
FRONTEND_URLS=

# --- Tests ---------------------------------------------------------------
# Les scripts `test_*.py` de la racine tapent sur les vrais services et ont
# besoin d'un compte. Préférer l'email + mot de passe d'un compte citoyen de
# TEST : un JWT collé à la main expire en une heure, et les scripts cassent
# alors tous en silence (c'est ce qui est arrivé : TEST_SUPABASE_TOKEN était
# périmé depuis 85 jours).
TEST_CITOYEN_EMAIL=
TEST_CITOYEN_MOT_DE_PASSE=
# Repli : un JWT déjà obtenu (durée de vie courte).
TEST_SUPABASE_TOKEN=

# --- Divers --------------------------------------------------------------
# Délai de récupération du JWKS Supabase, en secondes (défaut 20).
DELAI_JWKS_SECONDES=20

# `SUPABASE_JWT_SECRET` n'est plus lu : depuis la revue de sécurité du
# 2026-09-14, `auth.py` n'accepte que des signatures asymétriques vérifiées
# contre le JWKS (ES256/RS256/EdDSA), jamais HS256. Ne pas le remettre.
